{
	"name": "gallery",
	"version": "0.9.3",
	"description": "A fast section-aware media gallery for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import tsx --test tests/*.test.ts",
		"lint": "eslint .",
		"check": "npm run test && npm run build && npm run lint",
		"release:prepare": "npm run check && node scripts/prepare-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json src/mobile-diagnostics.ts styles.css"
	},
	"keywords": [
		"obsidian",
		"gallery",
		"images",
		"video",
		"sidebar"
	],
	"author": "ambinder",
	"license": "MIT",
	"engines": {
		"node": ">=20.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
